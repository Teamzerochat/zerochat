namespace nym_transport {
    // SPAKE2+ password-authenticated key exchange
    [Throws=Spake2Error]
    Spake2InitiatorHandle spake2_start_initiator_wrapper(sequence<u8> password);
    
    [Throws=Spake2Error]
    u64 spake2_finish_initiator_wrapper(u64 handle_id, sequence<u8> inbound_msg);
    
    [Throws=Spake2Error]
    Spake2ResponderResult spake2_start_responder_wrapper(sequence<u8> password, sequence<u8> inbound_msg);
    
    boolean spake2_cleanup_state_wrapper(u64 handle_id);
    
    u64 spake2_active_count_wrapper();

    // Session store — encrypt/decrypt with session key held in Rust
    [Throws=SessionError]
    sequence<u8> session_encrypt_wrapper(u64 handle, sequence<u8> plaintext);
    
    [Throws=SessionError]
    sequence<u8> session_decrypt_wrapper(u64 handle, sequence<u8> ciphertext);
    
    [Throws=SessionError]
    sequence<u8> session_generate_confirmation_wrapper(u64 handle, u8 role);
    
    [Throws=SessionError]
    boolean session_verify_confirmation_wrapper(u64 handle, sequence<u8> confirmation, u8 role);
    
    void session_destroy_wrapper(u64 handle);
};

[Error]
enum Spake2Error {
    "InvalidHandle",
    "HandshakeFailed",
};

[Error]
enum SessionError {
    "InvalidHandle",
    "EncryptionFailed",
    "DecryptionFailed",
    "InvalidRole",
    "SessionExpired",
};

dictionary Spake2InitiatorHandle {
    u64 handle_id;
    sequence<u8> outbound_msg;
};

dictionary Spake2ResponderResult {
    sequence<u8> outbound_msg;
    u64 session_handle;
};

[Error]
enum TransportError {
    "NotConnected",
    "ConnectionFailed",
    "SendFailed",
    "InvalidAddress",
    "RuntimeError",
};

dictionary RendezvousMessage {
    sequence<u8> sender_handle;
    sequence<u8> payload;
};

dictionary ConnectionInfo {
    string my_address;
    boolean connected;
};

interface NymTransportClient {
    constructor();
    
    // Connect to NYM public mainnet (gateway_url ignored, uses mainnet)
    [Throws=TransportError]
    string connect(string gateway_url);
    
    void disconnect();
    
    boolean is_connected();
    
    ConnectionInfo get_connection_info();
    
    [Throws=TransportError]
    sequence<RendezvousMessage> poll_rendezvous(string point_id);
    
    [Throws=TransportError]
    void send_message(sequence<u8> handle, sequence<u8> payload);
    
    [Throws=TransportError]
    void publish_at_rendezvous(string point_id, sequence<u8> my_handle);
    
    [Throws=TransportError]
    RendezvousMessage? receive_message(u64 timeout_ms);
    
    // Connect with custom identity for DEBUG MODE ONLY
    [Throws=TransportError]
    string connect_with_custom_identity(sequence<u8> rendezvous_seed, string gateway_id);
    
    [Throws=TransportError]
    string get_rendezvous_address(string point_id);
    
    // Connect to rendezvous point with deterministic gateway
    [Throws=TransportError]
    string connect_rendezvous(string point_id);
    
    // Explicitly disconnect from a specific rendezvous point
    [Throws=TransportError]
    void disconnect_rendezvous(string point_id);

    // Explicitly disconnect all rendezvous clients
    void disconnect_all_rendezvous();
};
