namespace nym_transport {
    // SPAKE2+ password-authenticated key exchange
    [Throws=Spake2Error]
    Spake2InitiatorHandle spake2_start_initiator_wrapper(sequence<u8> password);
    
    [Throws=Spake2Error]
    u64 spake2_finish_initiator_wrapper(u64 handle_id, sequence<u8> inbound_msg);
    
    [Throws=Spake2Error]
    Spake2ResponderResult spake2_start_responder_wrapper(sequence<u8> password, sequence<u8> inbound_msg);
    
    boolean spake2_cleanup_state_wrapper(u64 handle_id);
    
    u64 spake2_active_count_wrapper();

    // Session store — encrypt/decrypt with session key held in Rust
    [Throws=SessionError]
    sequence<u8> session_encrypt_wrapper(u64 handle, sequence<u8> plaintext);
    
    [Throws=SessionError]
    sequence<u8> session_decrypt_wrapper(u64 handle, sequence<u8> ciphertext);
    
    [Throws=SessionError]
    sequence<u8> session_generate_confirmation_wrapper(u64 handle, u8 role);
    
    [Throws=SessionError]
    boolean session_verify_confirmation_wrapper(u64 handle, sequence<u8> confirmation, u8 role);
    
    // Retrieve obfs4_state (64 bytes) derived from SPAKE2+ shared secret
    [Throws=SessionError]
    sequence<u8> session_get_obfs4_state_wrapper(u64 handle);

    // Retrieve ZCAP k_shared (32 bytes), domain-separated from obfs4_state
    [Throws=SessionError]
    sequence<u8> session_get_zcap_shared_secret_wrapper(u64 handle);
    
    void session_destroy_wrapper(u64 handle);

    // Secure in-memory ring-buffer (zeroizes on drop / clear)
    void secure_log_write(string entry);
    void secure_log_clear();
    u32 secure_log_len();

    // ── ZCAP: Epoch & mailbox derivation ────────────────────────────────────
    u64 zcap_epoch_offset(sequence<u8> k_shared);
    u64 zcap_current_epoch(sequence<u8> k_shared, u64 utc_now_secs);
    sequence<u8> zcap_mailbox_id(sequence<u8> k_shared, u64 epoch, u8 replica);
    u32? zcap_gateway_index(sequence<u8> k_shared, u64 epoch, u8 replica, u32 gateway_count);
    sequence<u64> zcap_missed_epochs(sequence<u8> k_shared, u64 utc_now_secs);

    // ── ZCAP: Double Ratchet KEM ─────────────────────────────────────────────
    ZcapKemResult zcap_kem_initiate(sequence<u8> responder_public_key);
    ZcapKemResult zcap_kem_respond(sequence<u8> initiator_ephemeral_public, sequence<u8> my_static_secret);

    // ── ZCAP: Ratchet encrypt / decrypt ─────────────────────────────────────
    ZcapEncryptResult ratchet_encrypt(sequence<u8> serialized_state, sequence<u8> plaintext);
    ZcapDecryptResult ratchet_decrypt(sequence<u8> serialized_state, sequence<u8> ciphertext);

    // ── ZCAP: Sphinx padding ─────────────────────────────────────────────────
    sequence<u8> pad_to_sphinx_size(sequence<u8> payload);
    sequence<u8> unpad_sphinx_payload(sequence<u8> packet);

    // ── ZCAP: SURB manager ───────────────────────────────────────────────────
    sequence<sequence<u8>> generate_surbs(u32 count);
    boolean acknowledge_surb(sequence<u8> surb_id);
    u32 surb_pending_count();
    void surb_clear_all();

    // ── ZCAP: Swarm dispatch ─────────────────────────────────────────────────
    ZcapSendResult zcap_send(
        u64 transport_handle,
        sequence<u8> serialized_state,
        sequence<u8> plaintext,
        sequence<sequence<u8>> replicas,
        sequence<string> gateway_identities
    );

    // ── ZCAP: Lewes offline fetch ────────────────────────────────────────────
    ZcapFetchResult zcap_fetch_messages(
        u64 transport_handle,
        sequence<u8> serialized_state,
        sequence<u8> k_shared,
        u64 utc_now_secs,
        sequence<string> gateway_identities
    );
}; // end namespace

// ── ZCAP result dictionaries ─────────────────────────────────────────────────

/// Result of a KEM initiation or response. Contains the public key bytes
/// and the initial serialized ratchet state blob.
dictionary ZcapKemResult {
    sequence<u8> public_key_bytes;
    sequence<u8> serialized_state;
};

/// Result of a ratchet encryption call.
dictionary ZcapEncryptResult {
    sequence<u8> ciphertext;
    sequence<u8> updated_state;
};

/// Result of a ratchet decryption call.
dictionary ZcapDecryptResult {
    sequence<u8> plaintext;
    sequence<u8> updated_state;
};

/// Result of a ZCAP swarm send.
dictionary ZcapSendResult {
    sequence<u8> updated_state;
    u32 succeeded_replicas;
};

/// Result of a ZCAP offline fetch.
dictionary ZcapFetchResult {
    sequence<sequence<u8>> decrypted_messages;
    sequence<u8> updated_state;
};

[Error]
enum Spake2Error {
    "InvalidHandle",
    "HandshakeFailed",
};

[Error]
enum SessionError {
    "InvalidHandle",
    "EncryptionFailed",
    "DecryptionFailed",
    "InvalidRole",
    "SessionExpired",
};

dictionary Spake2InitiatorHandle {
    u64 handle_id;
    sequence<u8> outbound_msg;
};

dictionary Spake2ResponderResult {
    sequence<u8> outbound_msg;
    u64 session_handle;
};

[Error]
enum TransportError {
    "NotConnected",
    "ConnectionFailed",
    "SendFailed",
    "InvalidAddress",
    "RuntimeError",
};

dictionary RendezvousMessage {
    sequence<u8> sender_handle;
    sequence<u8> payload;
};

dictionary ConnectionInfo {
    string my_address;
    boolean connected;
};

interface NymTransportClient {
    constructor();
    
    // Connect to NYM public mainnet (gateway_url ignored, uses mainnet)
    [Throws=TransportError]
    string connect(string gateway_url);
    
    void disconnect();
    
    boolean is_connected();
    
    ConnectionInfo get_connection_info();
    
    [Throws=TransportError]
    sequence<RendezvousMessage> poll_rendezvous(string point_id);
    
    [Throws=TransportError]
    void send_message(sequence<u8> handle, sequence<u8> payload);
    
    [Throws=TransportError]
    void publish_at_rendezvous(string point_id, sequence<u8> my_handle, string base_point_id);
    
    [Throws=TransportError]
    RendezvousMessage? receive_message(u64 timeout_ms);
    
    // TLI lifecycle management (Paper §5.3)
    [Throws=TransportError]
    u8 tli_transition(u8 phase); // Returns new phase as u8

    u8 tli_current_phase(); // Returns current phase as u8

    boolean tli_check_churn(u8 signal_type); // Returns true if churn detected

    void tli_terminate_session(); // Terminate session and zeroize all material

    // Cover traffic scheduler (Paper §5)
    void cover_traffic_start(); // Start adaptive cover traffic
    void cover_traffic_stop(); // Stop cover traffic
    void cover_traffic_set_thermal_throttle(boolean active); // Set thermal throttle state
    u64 cover_traffic_current_delay_ms(); // Get current inter-packet delay in ms

    // Connect with custom identity for DEBUG MODE ONLY
    [Throws=TransportError]
    string connect_with_custom_identity(sequence<u8> rendezvous_seed, string gateway_id);
    
    [Throws=TransportError]
    string get_rendezvous_address(string point_id);
    
    // Connect to rendezvous point with deterministic gateway
    [Throws=TransportError]
    string connect_rendezvous(string point_id);
    
    // Explicitly disconnect from a specific rendezvous point
    [Throws=TransportError]
    void disconnect_rendezvous(string point_id);

    // Explicitly disconnect all rendezvous clients
    void disconnect_all_rendezvous();

    // Register/unregister this connected client for ZCAP offline operations.
    u64 zcap_register_transport();
    void zcap_unregister_transport(u64 handle);
};
